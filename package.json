{
  "name": "qalinraac-academy",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm -r --parallel --filter @qalinraac/api --filter @qalinraac/web dev",
    "dev:api": "pnpm --filter @qalinraac/api dev",
    "dev:web": "pnpm --filter @qalinraac/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  },
  "engines": {
    "node": ">=22"
  }
}
