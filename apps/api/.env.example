# Copy this file to .env and fill secrets for live services.
# Local defaults below work for MongoDB + JWT without cloud keys.

SEED_ON_BOOT=true
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000

MONGODB_URI=mongodb://127.0.0.1:27017/qalinraac_academy
REDIS_URL=redis://127.0.0.1:6379

JWT_ACCESS_SECRET=qalinraac_local_access_secret_change_in_prod_7f3a9c2e
JWT_REFRESH_SECRET=qalinraac_local_refresh_secret_change_in_prod_b8d1e4a6
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

UPLOAD_DIR=uploads

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

EMAIL_ENABLED=false
SES_REGION=us-east-1
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
EMAIL_FROM=noreply@qalinraac.local

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

WAAFI_API_URL=https://api.waafipay.net/asm
WAAFI_MERCHANT_UID=
WAAFI_API_USER_ID=
WAAFI_API_KEY=
