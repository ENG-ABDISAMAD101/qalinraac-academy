############################################
# Qalinraac Academy — environment template
# Copy values into:
#   apps/api/.env
#   apps/web/.env.local
############################################

# ========== apps/api/.env ==========

SEED_ON_BOOT=true
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000

MONGODB_URI=mongodb://127.0.0.1:27017/qalinraac_academy
REDIS_URL=redis://127.0.0.1:6379

JWT_ACCESS_SECRET=qalinraac_local_access_secret_change_in_prod_7f3a9c2e
JWT_REFRESH_SECRET=qalinraac_local_refresh_secret_change_in_prod_b8d1e4a6
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

UPLOAD_DIR=uploads

# Cloudflare R2 (optional)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
# Public CDN / r2.dev pub URL (https://pub-xxxxx.r2.dev). Without this, avatars use signed view URLs.
R2_PUBLIC_URL=

# Amazon SES (optional)
EMAIL_ENABLED=false
SES_REGION=us-east-1
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
EMAIL_FROM=noreply@qalinraac.local

# Stripe (optional — empty = simulate)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Waafi (optional — empty = simulate)
WAAFI_API_URL=https://api.waafipay.net/asm
WAAFI_MERCHANT_UID=
WAAFI_API_USER_ID=
WAAFI_API_KEY=

# ========== apps/web/.env.local ==========

NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_NAME=Qalinraac Academy
NEXT_PUBLIC_ACADEMY_SUPPORT_EMAIL=support@qalinraac.local
